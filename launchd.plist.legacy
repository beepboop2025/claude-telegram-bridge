<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.beepboop2025.claude-telegram-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-si</string>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/user/dev/claude-telegram-bridge/bridge.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/user/dev/claude-telegram-bridge</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/user/dev/claude-telegram-bridge/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/user/dev/claude-telegram-bridge/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/user/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/user</string>
  </dict>
</dict>
</plist>
